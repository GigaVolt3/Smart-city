# CivicAI — Monorepo .gitignore

# ── Secrets ───────────────────────────────────────────────────────────────────
.env
.env.local
.env.production
*.pem
*.key
secrets/

# ── Python / Backend ──────────────────────────────────────────────────────────
backend/__pycache__/
backend/**/__pycache__/
backend/*.pyc
backend/.venv/
backend/venv/
backend/.pytest_cache/
backend/.mypy_cache/
backend/htmlcov/
backend/.coverage
backend/uploads/
*.db
*.sqlite
*.sqlite3

# ── Flutter / Mobile ──────────────────────────────────────────────────────────
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/build/
mobile/.packages
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/key.properties
mobile/**/*.g.dart
mobile/**/*.freezed.dart
mobile/**/*.mocks.dart

# ── Node / Dashboard ──────────────────────────────────────────────────────────
dashboard/node_modules/
dashboard/dist/
dashboard/.vite/
dashboard/.env

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ───────────────────────────────────────────────────────────────────────
.idea/
.vscode/settings.json
*.iml
