# CivicAI Backend Configuration
PROJECT_NAME="CivicAI — Smart Civic Grievance System"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Security & Authentication
# Generate in production: openssl rand -hex 32
SECRET_KEY="civicai-dev-secret-key-replace-in-production-min-32-chars-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration
# PostgreSQL: postgresql+psycopg://civicai:civicai@localhost:5432/civicai_db
# SQLite fallback (default for ₹0 zero-setup local dev/testing): sqlite:///./civicai.db
DATABASE_URL="sqlite:///./civicai.db"

# CORS Configuration (comma-separated origins or JSON array)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# File Storage
UPLOAD_DIR="./uploads"

# Escalation Engine (Phase 4 dev settings)
DEV_MODE=True
ESCALATION_CHECK_INTERVAL_SECONDS=60
